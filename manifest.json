{
  "manifest_version": 3,
  "name": "Maker · 天一一",
  "version": "1.1.0.0",
  "author": "Linxium (CS-LX)",
  "description": "自定义 TapTap Maker 聊天助手的昵称和头像，默认使用天一一。",
  "permissions": ["storage"],
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' data: blob:; style-src 'self'; connect-src 'none'; base-uri 'none';"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Maker · 天一一",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://maker.taptap.cn/*"],
      "js": ["profile.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/tianyi.jpg"],
      "matches": ["https://maker.taptap.cn/*"]
    }
  ]
}
