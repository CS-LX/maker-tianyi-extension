{
  "manifest_version": 3,
  "name": "Maker · 天一一",
  "version": "1.0.0.1",
  "author": "Linxium (CS-LX)",
  "description": "在 TapTap Maker 聊天中，将嗒啦啦的名字和头像替换为天一一。",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Maker · 天一一",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://maker.taptap.cn/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/tianyi.jpg"],
      "matches": ["https://maker.taptap.cn/*"]
    }
  ]
}
