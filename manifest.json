{
  "manifest_version": 3,
  "name": "Maker · 天一一",
  "version": "1.2.0.0",
  "author": "Linxium (CS-LX)",
  "description": "自定义 TapTap Maker 聊天助手的昵称、头像和黑金卡图案。",
  "permissions": ["storage"],
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' data: blob: https://maker.taptap.cn; style-src 'self'; connect-src 'none'; base-uri 'none';"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Maker · 天一一",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://maker.taptap.cn/*"],
      "js": ["profile.js", "card-profile.js", "content.js", "cards.js"],
      "css": ["cards.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/tianyi.jpg", "assets/cards/tara.webp", "assets/cards/frog.png"],
      "matches": ["https://maker.taptap.cn/*"]
    }
  ]
}
